{
  // Prepared cutover configuration only. Deploying custom_domain changes DNS.
  // Do not run this configuration before the founder's final DNS approval.
  "name": "stackendbox-production",
  "main": "platform/cloudflare/full-site-gateway.ts",
  "compatibility_date": "2026-10-13",
  // The approved Google backup consent app links to this existing hostname's
  // public privacy/information pages. Preserve it until those URLs are migrated.
  // Customer invitations and authentication still use the company-domain origin.
  "workers_dev": true,
  "preview_urls": false,
  "routes": [{ "pattern": "www.stackendbox.com", "custom_domain": true }, { "pattern": "stackendbox.com", "custom_domain": true }],
  "assets": {
    "directory": "dist/static",
    "binding": "ASSETS",
    "html_handling": "none",
    "run_worker_first": ["/", "/index.html", "/api/*", "/admin", "/admin/*", "/client-portal", "/client-portal/*"]
  },
  "vars": {
    "EDGE_BACKEND_URL": "https://irzjkdxxfvobtabwkqmz.supabase.co/functions/v1/stackendbox-production",
    "EDGE_BACKEND_REGION": "ap-northeast-1",
    "PORTAL_JOBS_ENABLED": "false"
  },
  "triggers": { "crons": [] },
  "observability": { "enabled": true }
}
