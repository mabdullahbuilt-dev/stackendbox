{
  "name": "stackendbox-static-acceptance",
  "main": "platform/cloudflare/gateway.ts",
  "compatibility_date": "2026-10-13",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "dist/static",
    "binding": "ASSETS",
    "html_handling": "none",
    "run_worker_first": ["/api/*", "/client-portal/auth/callback"]
  },
  "vars": { "EDGE_BACKEND_URL": "https://irzjkdxxfvobtabwkqmz.supabase.co/functions/v1/stackendbox-acceptance", "EDGE_BACKEND_REGION": "ap-northeast-1", "PORTAL_JOBS_ENABLED": "true" },
  "triggers": { "crons": ["*/10 * * * *", "0 0 * * *"] },
  "observability": { "enabled": true }
}
