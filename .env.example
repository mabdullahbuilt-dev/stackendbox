# Public site values (all optional; UI that depends on a missing value is omitted)
NEXT_PUBLIC_SITE_URL=https://www.stackendbox.com
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_SCHEDULING_URL=
NEXT_PUBLIC_WHATSAPP_URL=
NEXT_PUBLIC_GITHUB_URL=
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_X_URL=
# Analytics provider endpoint (optional; wrapper no-ops until configured)
NEXT_PUBLIC_ANALYTICS_ENDPOINT=

# Brief delivery (server only). Configure at least one, otherwise /api/brief answers 503.
# 1) Generic webhook (CRM / Zapier / n8n / Slack-compatible JSON endpoint)
BRIEF_WEBHOOK_URL=
# 2) Email via Resend
RESEND_API_KEY=
BRIEF_TO_EMAIL=
BRIEF_FROM_EMAIL=
