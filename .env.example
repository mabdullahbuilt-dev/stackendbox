# Public site values (all optional; UI that depends on a missing value is omitted)
NEXT_PUBLIC_SITE_URL=https://www.stackendbox.com
NEXT_PUBLIC_COMPANY_EMAIL=
NEXT_PUBLIC_CAL_URL=
NEXT_PUBLIC_WHATSAPP_URL=
NEXT_PUBLIC_GITHUB_URL=
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_X_URL=
# Analytics provider endpoint (optional; wrapper no-ops until configured)
NEXT_PUBLIC_ANALYTICS_ENDPOINT=

# Brief delivery (server only), via Brevo transactional email
BREVO_API_KEY=
BREVO_SENDER_EMAIL=hello@stackendbox.com
BREVO_SENDER_NAME=StackEndBox
BRIEF_TO_EMAIL=hello@stackendbox.com

# Optional bot protection (both required to enable Turnstile)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
