# Public site values (all optional; UI that depends on a missing value is omitted)
NEXT_PUBLIC_SITE_URL=https://www.stackendbox.com
NEXT_PUBLIC_COMPANY_EMAIL=hello@stackendbox.com
NEXT_PUBLIC_CAL_URL=https://cal.com/stackendbox/work-with-stackendbox
NEXT_PUBLIC_CONTACT_PHONE=+44 7366 847680
NEXT_PUBLIC_WHATSAPP_URL=https://wa.me/message/4LZFXFNE5TT7O1
NEXT_PUBLIC_GITHUB_URL=
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_X_URL=
# Analytics provider endpoint (optional; wrapper no-ops until configured)
NEXT_PUBLIC_ANALYTICS_ENDPOINT=

# Brief delivery (server only), via Brevo transactional email
BREVO_API_KEY=
BREVO_SENDER_EMAIL=hello@stackendbox.com
BREVO_SENDER_NAME=StackEndBox
BRIEF_TO_EMAIL=hello@stackendbox.com

# Optional bot protection (both required to enable Turnstile)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Invite-only portal. Never expose server credentials with NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
PORTAL_APP_URL=
SPACESHIP_API_KEY=
SPACESHIP_API_SECRET=
WHOP_MODE=sandbox
WHOP_SANDBOX_COMPANY_ID=
WHOP_SANDBOX_API_KEY=
WHOP_SANDBOX_REGISTRATION_PRODUCT_ID=
WHOP_SANDBOX_RENEWAL_PRODUCT_ID=
WHOP_SANDBOX_WEBHOOK_SECRET=
DOMAIN_LIVE_PURCHASES_ENABLED=false
DOMAIN_LIVE_RENEWALS_ENABLED=false
DOMAIN_LIVE_MUTATIONS_ENABLED=false
# Explicit domains authorized for live DNS/nameserver/privacy changes, never corporate assets.
DOMAIN_MUTATION_ALLOWLIST=
BREVO_CLIENT_API_KEY=
BREVO_CLIENT_SENDER_EMAIL=
BREVO_CLIENT_SENDER_NAME=StackEndBox
BREVO_CLIENT_REPLY_TO=
CRON_SECRET=
